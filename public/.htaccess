Options -MultiViews
RewriteEngine On
RewriteBase /

# API/Nitro routes and static files must not be rewritten to index.html.
RewriteCond %{REQUEST_URI} ^/api/ [OR]
RewriteCond %{REQUEST_URI} ^/listings [OR]
RewriteCond %{REQUEST_URI} ^/favourites [OR]
RewriteCond %{REQUEST_URI} ^/activity [OR]
RewriteCond %{REQUEST_URI} ^/images/ [OR]
RewriteCond %{REQUEST_URI} ^/assets/ [OR]
RewriteCond %{REQUEST_URI} ^/upload\.php [OR]
RewriteCond %{REQUEST_URI} ^/sitemap\.xml
RewriteRule ^ - [L]

RewriteRule ^index\.html$ - [L]

RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} -f [OR]
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} -d
RewriteRule ^ - [L]

RewriteRule ^ /index.html [L]
