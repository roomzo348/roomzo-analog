# One-time Nginx setup on VPS:
# sudo cp nginx.roomzo.conf.example /etc/nginx/sites-available/roomzo
# sudo ln -sf /etc/nginx/sites-available/roomzo /etc/nginx/sites-enabled/roomzo
# sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    server_name roomzo.in www.roomzo.in;
    return 301 https://www.roomzo.in$request_uri;
}

server {
    listen 443 ssl http2;
    server_name www.roomzo.in;

    # ssl_certificate /etc/letsencrypt/live/www.roomzo.in/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/www.roomzo.in/privkey.pem;

    client_max_body_size 25M;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /ws-chat {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }
}
